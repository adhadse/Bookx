msgstr "Recherche d’appareils"

msgid "Looking for the e-reader"
msgstr "Recherche de la liseuse"

msgid "Not a known e-reader"
msgstr "Pas une liseuse connue"

msgid "Other drives"
msgstr "Autres lecteurs"

msgid "Other e-reader"
msgstr "Autre liseuse"

msgid "Removable drives that Bookx does not recognise as e-readers (USB sticks, card readers, disks). If one of them is an e-reader, tell Bookx and it is offered like any other device."
msgstr "Lecteurs amovibles que Bookx ne reconnaît pas comme des liseuses (clés USB, lecteurs de cartes, disques). Si l’un d’eux est une liseuse, indiquez-le à Bookx et il sera proposé comme n’importe quel appareil."

msgid "Stop using as an e-reader"
msgstr "Ne plus utiliser comme liseuse"

msgid "Use as an e-reader"
msgstr "Utiliser comme liseuse"

msgid "Use {} as an e-reader?"
msgstr "Utiliser {} comme liseuse ?"

